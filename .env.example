# EVORA Public Environment Configuration
# Copy this file to .env.local for local overrides

# Site URL for canonical links and OpenGraph meta tags
NEXT_PUBLIC_SITE_URL=https://evorawomen.com

# WhatsApp Ordering & Inquiry (International format without '+' or spaces, e.g., 17025550199)
NEXT_PUBLIC_WHATSAPP_NUMBER=17025550199

# Primary Brand Inquiries Email
NEXT_PUBLIC_CONTACT_EMAIL=concierge@evorawomen.com

# Official Instagram Profile URL
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/evorawomen

# Las Vegas Location / Atelier Display
NEXT_PUBLIC_CITY_REGION=Las Vegas, Nevada
NEXT_PUBLIC_ATELIER_HOURS="By Private Appointment Only"

# Optional Contact Form Endpoint (e.g. Formspree / Cloudflare Worker / Webhook)
# If left empty, form will gracefully handle inquiries client-side with full confirmation
NEXT_PUBLIC_FORM_ENDPOINT=
